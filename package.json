{
  "name": "rakazo",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": "^24.0.0 || >=26.0.0",
    "bun": "1.4.2"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:services": "turbo dev --env-mode=loose --filter=@rakazo/api --filter=@rakazo/worker --filter=@rakazo/web",
    "dev:managed": "turbo dev --env-mode=loose --filter=@rakazo/api --filter=@rakazo/worker --filter=@rakazo/web --filter=@rakazo/sandbox-supervisor",
    "dev:pi": "node scripts/dev.mjs --pi",
    "dev:kit": "node scripts/dev.mjs --setup-kit --install-pi --install-kit",
    "test:dev": "vitest run packages/testkit/src/dev-bootstrap.test.ts",
    "build": "turbo build",
    "check": "turbo check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "bun run --filter @rakazo/db generate",
    "db:migrate": "bun run --filter @rakazo/db migrate",
    "sandbox:build": "docker build -t rakazo/computer:local infra/sandboxes/computer && bun run sandbox:agent:build",
    "sandbox:agent:build": "docker build -f infra/compose/Dockerfile -t rakazo/agent:local .",
    "test": "vitest run",
    "test:compose-smoke": "bash infra/compose/run-smokes.sh",
    "test:integration": "tsx packages/testkit/src/cli/harness.ts --integration",
    "test:e2e": "tsx packages/testkit/src/cli/harness.ts --e2e",
    "test:mobile-screenshots": "bun run --filter @rakazo/db generate && tsx packages/testkit/src/cli/mobile-screenshots.ts",
    "test:topology": "tsx packages/testkit/src/cli/topology.ts",
    "test:canary": "tsx packages/testkit/src/cli/canary.ts",
    "pi:kit:check": "tsx scripts/check-pi-kit.ts && vitest run packages/pi-kit/src",
    "pi:kit:vendor": "node scripts/vendor-pi-kit.mjs",
    "test:pi": "vitest run packages/testkit/src/model-emulator.test.ts packages/testkit/src/pi-offline.test.ts",
    "test:evals": "tsx packages/testkit/src/cli/evals.ts",
    "test:computer-replay": "tsx packages/testkit/src/cli/computer-replay.ts",
    "test:computer": "tsx packages/testkit/src/cli/computer.ts",
    "perf:desktop": "tsx packages/testkit/src/cli/desktop-performance.ts",
    "perf:compare": "tsx packages/testkit/src/cli/compare-performance.ts",
    "compose:up": "docker compose --env-file .env -f infra/compose/docker-compose.yml up --build",
    "compose:down": "docker compose --env-file .env -f infra/compose/docker-compose.yml down -v",
    "test:install": "node scripts/check-workspace-install.mjs && vitest run packages/testkit/src/workspace-install.test.ts",
    "preinstall": "node scripts/check-package-manager.mjs",
    "preview:ux": "node --import tsx packages/testkit/src/cli/ux-preview.ts",
    "capture:ux": "node --import tsx packages/testkit/src/cli/capture-ux-preview.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/node": "^24.3.0",
    "cross-env": "^10.1.0",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra/sandboxes/supervisor",
    "infra/updater"
  ],
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "patchedDependencies": {
    "app-builder-lib@26.15.3": "patches/app-builder-lib@26.15.3.patch"
  },
  "trustedDependencies": [
    "@ast-grep/cli",
    "@prisma/engines",
    "cpu-features",
    "electron",
    "electron-winstaller",
    "esbuild",
    "koffi",
    "prisma",
    "ssh2"
  ]
}
